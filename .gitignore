node_modules/
.env
.env.local

# Artefacts de génération — jamais commités (volumineux, régénérables)
output/*
!output/.gitkeep

# Images téléchargées depuis Pexels pendant un run
assets/images/*
!assets/images/.gitkeep

# Pistes musicales : on versionne le pack CC0 (FreePD) fourni avec le repo.
# Toute piste ajoutée doit être libre de droits (CC0 / domaine public).
assets/music/*
!assets/music/README.md
!assets/music/CREDITS.md
!assets/music/*.mp3

# Divers
.DS_Store
*.log
whisper_models/
__pycache__/
*.pyc
.remotion/

# Assets Remotion stagés à chaque run (voix, musique, images) — régénérables
public/current/

# Build Remotion (bundle de test)
build/

# IDE JetBrains
.idea/
