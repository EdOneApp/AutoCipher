# =============================================================================
#  AutoCipher — variables d'environnement
#  Copier ce fichier en `.env` pour les tests en local.
#  En production : configurer chaque valeur comme "Repository secret" GitHub
#  (Settings → Secrets and variables → Actions → New repository secret).
# =============================================================================

# --- Génération de script (LLM) ----------------------------------------------
# Google AI Studio → https://ai.google.dev → "Get API Key" (gratuit, sans CB)
GEMINI_API_KEY=
# Optionnel : forcer un modèle Gemini précis. Par défaut le code essaie
# gemini-3.6-flash, puis gemini-flash-latest, puis gemini-2.5-flash.
GEMINI_MODEL=

# Groq — secours gratuit si Gemini est en panne / quota dépassé
# https://console.groq.com → API Keys
GROQ_API_KEY=
# Optionnel : modèle Groq. Défaut : openai/gpt-oss-120b
# (llama-3.3-70b-versatile a été retiré de Groq en juin 2026).
GROQ_MODEL=

# --- Images -----------------------------------------------------------------
# https://www.pexels.com/api/ → clé instantanée, gratuite
PEXELS_API_KEY=

# --- YouTube Data API v3 ---------------------------------------------------
# console.cloud.google.com → projet → activer "YouTube Data API v3"
# → identifiants OAuth2 (type "Application de bureau")
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Obtenu UNE fois via : npm run oauth-setup  (voir README)
YOUTUBE_REFRESH_TOKEN=

# --- Email de validation (Gmail SMTP) ------------------------------------
# Compte Gmail avec validation en 2 étapes activée.
# Mot de passe d'application : https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Destinataire de l'email de validation (par défaut = GMAIL_USER)
VALIDATION_EMAIL_TO=

# --- GitHub (création de l'issue de validation) -------------------------
# En GitHub Actions : fourni automatiquement (secrets.GITHUB_TOKEN).
# En local : Personal Access Token avec le scope "repo".
GITHUB_TOKEN=
# "owner/repo" — en Actions, fourni automatiquement via GITHUB_REPOSITORY
GITHUB_REPOSITORY=

# --- Réglages du pipeline (valeurs par défaut dans src/config.js) --------
# Format : "short" (1080x1920) — seul format supporté pour l'instant
VIDEO_FORMAT=short
# Durée cible de la voix off en secondes (30–60 pour un Short)
TARGET_DURATION_SECONDS=50
# Délai avant publication automatique si aucun rejet (heures)
APPROVAL_DELAY_HOURS=2
# Nombre de sujets récents interdits à la re-sélection
TOPIC_HISTORY_LOOKBACK=40
# Modèle Whisper : tiny | base | small  (base = bon compromis en CI)
WHISPER_MODEL=base
# Voix edge-tts
TTS_VOICE=fr-FR-DeniseNeural
# Plafond d'uploads YouTube par jour (quota 10000 u / 1600 u par upload)
YOUTUBE_DAILY_UPLOAD_CAP=6
